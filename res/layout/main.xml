<?xml version="1.0" encoding="utf-8"?>
<!-- Home. Order: one clear status with one main action, then the count, then everything else.
     Only tokens here: @dimen, @color, @style, @string. tools/check_tokens.py enforces it. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:id="@+id/content" style="@style/Screen">

        <!-- App bar: brand mark and wordmark. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="@dimen/space_16" android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="@dimen/space_1" android:paddingTop="@dimen/space_2"
            android:contentDescription="@string/app_name" android:focusable="true"
            android:accessibilityHeading="true">
            <ImageView android:layout_width="@dimen/logo_mark" android:layout_height="@dimen/logo_mark"
                android:src="@drawable/logo_mark" android:importantForAccessibility="no" />
            <ImageView android:layout_width="@dimen/wordmark_width" android:layout_height="@dimen/wordmark_height"
                android:layout_marginStart="@dimen/space_3" android:src="@drawable/wordmark"
                android:tint="@color/text_primary" android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Status hero. Colours, icon and texts are set per state in MainActivity.render(). -->
        <LinearLayout android:id="@+id/hero" style="@style/Hero">
            <ImageView android:id="@+id/hero_badge" style="@style/HeroBadge" android:src="@drawable/ic_status_on" />
            <TextView android:id="@+id/hero_title" style="@style/Text.HeadlineMedium.Emphasized"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5" android:accessibilityHeading="true"
                android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/hero_body" style="@style/Text.BodyLarge" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" />
            <!-- Main action while the service runs: block or pause. -->
            <Switch android:id="@+id/block_switch" style="@style/SwitchRow" android:text="@string/block_switch"
                android:visibility="gone" />
            <!-- Main action otherwise: turn on, fix, or update. -->
            <Button android:id="@+id/hero_action" style="@style/Button.Filled" android:visibility="gone" />
            <Button android:id="@+id/hero_action2" style="@style/Button.Text" android:layout_marginTop="@dimen/space_1"
                android:visibility="gone" />
        </LinearLayout>

        <!-- This week: on-device counts only. -->
        <LinearLayout android:id="@+id/week_card" style="@style/Card">
            <TextView style="@style/Text.TitleMedium" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/week_title" android:accessibilityHeading="true" />
            <LinearLayout android:id="@+id/week_numbers" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:focusable="true">
                <TextView android:id="@+id/week_count" style="@style/Text.DisplayLarge.Emphasized"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2" />
                <TextView android:id="@+id/week_label" style="@style/Text.BodyLarge.Secondary"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
            <dev.local.reelblock.WeekChart android:id="@+id/chart" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_5" />
            <TextView android:id="@+id/week_more" style="@style/Text.BodyMedium.Secondary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4" />
            <!-- Empty state: shown instead of the numbers while nothing was closed. -->
            <LinearLayout android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <TextView style="@style/EmptyState.Title" android:text="@string/empty_title" />
                <TextView style="@style/Text.BodyMedium.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1"
                    android:text="@string/empty_body" />
            </LinearLayout>
        </LinearLayout>

        <!-- Status -->
        <TextView style="@style/SectionHeader" android:text="@string/section_status" />
        <LinearLayout android:id="@+id/check_row" style="@style/Row.Single" android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/check_icon" style="@style/RowIcon" android:src="@drawable/ic_health" />
            <LinearLayout style="@style/RowTexts">
                <TextView style="@style/RowTitle" android:text="@string/check_title" />
                <TextView android:id="@+id/check_body" style="@style/RowBody" android:accessibilityLiveRegion="polite" />
            </LinearLayout>
        </LinearLayout>

        <!-- Shortcuts -->
        <TextView style="@style/SectionHeader" android:text="@string/section_shortcuts" />
        <LinearLayout android:id="@+id/tile_row" style="@style/Row.Top" android:clickable="true" android:focusable="true">
            <ImageView style="@style/RowIcon" android:src="@drawable/ic_tile" />
            <LinearLayout style="@style/RowTexts">
                <TextView style="@style/RowTitle" android:text="@string/tile_row_title" />
                <TextView style="@style/RowBody" android:text="@string/tile_row_body" />
            </LinearLayout>
            <ImageView style="@style/RowTrailing" android:src="@drawable/ic_chevron" />
        </LinearLayout>
        <!-- Shown only on phones with the Xiaomi Autostart screen. -->
        <LinearLayout android:id="@+id/autostart_row" style="@style/Row" android:clickable="true" android:focusable="true"
            android:visibility="gone">
            <ImageView style="@style/RowIcon" android:src="@drawable/ic_restart" />
            <LinearLayout style="@style/RowTexts">
                <TextView style="@style/RowTitle" android:text="@string/autostart_title" />
                <TextView style="@style/RowBody" android:text="@string/autostart_body" />
            </LinearLayout>
            <ImageView style="@style/RowTrailing" android:src="@drawable/ic_chevron" />
        </LinearLayout>
        <LinearLayout android:id="@+id/help_row" style="@style/Row.Bottom" android:clickable="true" android:focusable="true">
            <ImageView style="@style/RowIcon" android:src="@drawable/ic_help" />
            <LinearLayout style="@style/RowTexts">
                <TextView style="@style/RowTitle" android:text="@string/help_title" />
                <TextView style="@style/RowBody" android:text="@string/help_body" />
            </LinearLayout>
            <ImageView style="@style/RowTrailing" android:src="@drawable/ic_chevron" />
        </LinearLayout>

        <!-- Privacy: the promises the code keeps. -->
        <TextView style="@style/SectionHeader" android:text="@string/section_privacy" />
        <LinearLayout style="@style/Row.Top" android:focusable="true">
            <ImageView style="@style/RowIcon" android:src="@drawable/ic_no_internet" />
            <LinearLayout style="@style/RowTexts">
                <TextView style="@style/RowTitle" android:text="@string/priv_net_title" />
                <TextView style="@style/RowBody" android:text="@string/priv_net_body" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout style="@style/Row" android:focusable="true">
            <ImageView style="@style/RowIcon" android:src="@drawable/ic_eye_off" />
            <LinearLayout style="@style/RowTexts">
                <TextView style="@style/RowTitle" android:text="@string/priv_see_title" />
                <TextView style="@style/RowBody" android:text="@string/priv_see_body" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout style="@style/Row" android:focusable="true">
            <ImageView style="@style/RowIcon" android:src="@drawable/ic_lock" />
            <LinearLayout style="@style/RowTexts">
                <TextView style="@style/RowTitle" android:text="@string/priv_data_title" />
                <TextView style="@style/RowBody" android:text="@string/priv_data_body" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/code_row" style="@style/Row.Bottom" android:clickable="true" android:focusable="true">
            <ImageView style="@style/RowIcon" android:src="@drawable/ic_code" />
            <LinearLayout style="@style/RowTexts">
                <TextView style="@style/RowTitle" android:text="@string/priv_code_title" />
                <TextView style="@style/RowBody" android:text="@string/priv_code_body" />
            </LinearLayout>
            <ImageView style="@style/RowTrailing" android:src="@drawable/ic_open" />
        </LinearLayout>

        <LinearLayout android:id="@+id/share_row" style="@style/Row.Single" android:layout_marginTop="@dimen/space_6"
            android:clickable="true" android:focusable="true">
            <ImageView style="@style/RowIcon" android:src="@drawable/ic_share" />
            <LinearLayout style="@style/RowTexts">
                <TextView style="@style/RowTitle" android:text="@string/share_title" />
                <TextView style="@style/RowBody" android:text="@string/share_body_row" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/version" style="@style/Text.BodySmall" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_6" android:gravity="center" />
    </LinearLayout>
</ScrollView>
