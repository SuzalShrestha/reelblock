<?xml version="1.0" encoding="utf-8"?>
<!-- One permission only: com.android.vending.BILLING, to buy Pro from the Play Store app. No INTERNET.
     release.sh and CI fail the build if any other permission appears. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.local.reelblock" android:versionCode="8" android:versionName="2.1">
    <!-- Google Play requires targetSdk 36 for new apps and updates from 31 Aug 2026. -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <!-- Merged by hand from the Play Billing Library AAR (build.sh has no manifest merger). build.sh checks that
         BILLING_VERSION there and the meta-data value below are the same. -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <queries>
        <!-- Lets MainActivity see if the Xiaomi Autostart screen exists. -->
        <package android:name="com.miui.securitycenter" />
        <!-- Lets the self-check read Instagram's version and whether its Reels view name still exists.
             Package visibility only: it is not a permission and gives no access to Instagram's data. -->
        <package android:name="com.instagram.android" />
        <!-- Play Billing Library: lets it find the Play Store's billing service. -->
        <intent>
            <action android:name="com.android.vending.billing.InAppBillingService.BIND" />
        </intent>
    </queries>
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:allowBackup="false"
        android:dataExtractionRules="@xml/data_rules" android:theme="@style/Theme.ReelBlock"
        android:supportsRtl="true" android:enableOnBackInvokedCallback="true">
        <!-- Play Console reads this to check the billing library version. -->
        <meta-data android:name="com.google.android.play.billingclient.version" android:value="8.3.0" />
        <!-- Starts Google Play's purchase screen. ProxyBillingActivityV2 (alternative billing, external offers) is
             left out on purpose: Reel Block does not use those flows, and it would need AndroidX Activity. -->
        <activity android:name="com.android.billingclient.api.ProxyBillingActivity"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation"
            android:exported="false" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".ReelBlockService" android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility" />
        </service>
        <!-- Quick Settings tile. BIND_QUICK_SETTINGS_TILE is held by the system, not requested by this app. -->
        <service android:name=".QsTile" android:exported="true" android:label="@string/tile_label"
            android:icon="@drawable/ic_tile_brand"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
    </application>
</manifest>
