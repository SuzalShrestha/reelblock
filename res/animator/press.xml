<?xml version="1.0" encoding="utf-8"?>
<!-- Press feedback: the control shrinks a little, like M3 Expressive buttons. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="@dimen/press_scale" android:valueType="floatType"
                android:duration="@integer/motion_short3" android:interpolator="@interpolator/standard" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="@dimen/press_scale" android:valueType="floatType"
                android:duration="@integer/motion_short3" android:interpolator="@interpolator/standard" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType"
                android:duration="@integer/motion_short4" android:interpolator="@interpolator/emphasized_decelerate" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType"
                android:duration="@integer/motion_short4" android:interpolator="@interpolator/emphasized_decelerate" />
        </set>
    </item>
</selector>
