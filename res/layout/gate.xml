<?xml version="1.0" encoding="utf-8"?>
<!-- Pause screen over Instagram (ReelBlockService.showGate). Leaving is the main action; Continue turns on after 5 s. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/bg_window" android:fitsSystemWindows="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:gravity="center_vertical" android:padding="@dimen/space_6">
    <TextView style="@style/Text.HeadlineMedium.Emphasized" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/gate_title" />
    <TextView style="@style/Text.BodyLarge" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2" android:text="@string/gate_body" />
    <Button android:id="@+id/gate_leave" style="@style/Button.Filled" android:layout_marginTop="@dimen/space_8"
        android:text="@string/gate_leave" />
    <Button android:id="@+id/gate_continue" style="@style/Button.Text" android:text="@string/gate_continue" />
</LinearLayout>
</ScrollView>
