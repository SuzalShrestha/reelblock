<?xml version="1.0" encoding="utf-8"?>
<!-- Colour role tokens (Material 3), light. Generated from seed #2C7A7B; see docs/design-system.md.
     Android 12+ replaces the brand roles with the wallpaper colours: values-v31, values-v34.
     Layouts never use these names directly for surfaces; they use the semantic names in colors_semantic.xml.
     tools/check_contrast.py checks every pair in docs/design-system.md against these values. -->
<resources>
    <!-- Brand: calm teal (seed #2C7A7B, Material 3 "tonal spot" scheme from material-color-utilities 0.3.0, primary chroma 26 instead of 36: calm, not neon). -->
    <color name="primary">#FF326667</color>
    <color name="on_primary">#FFFFFFFF</color>
    <color name="primary_container">#FFB7ECEC</color>
    <color name="on_primary_container">#FF164E4F</color>
    <color name="secondary_container">#FFCCE8E8</color>
    <color name="on_secondary_container">#FF324B4B</color>
    <color name="tertiary_container">#FFD4E3FF</color>
    <!-- Error: fixed Material 3 error palette. Used only for real problems. -->
    <color name="error">#FFBA1A1A</color>
    <color name="on_error">#FFFFFFFF</color>
    <color name="error_container">#FFFFDAD6</color>
    <color name="on_error_container">#FF93000A</color>
    <!-- Surfaces: neutral palette, tinted toward the seed. Containers go from lowest to highest. -->
    <color name="surface">#FFF4FBFA</color>
    <color name="surface_container_lowest">#FFFFFFFF</color>
    <color name="surface_container">#FFE9EFEE</color>
    <color name="surface_container_high">#FFE3E9E9</color>
    <color name="surface_container_highest">#FFDDE4E3</color>
    <color name="on_surface">#FF161D1D</color>
    <color name="on_surface_variant">#FF3F4948</color>
    <color name="outline">#FF6F7979</color>
    <color name="outline_variant">#FFBEC8C8</color>
    <!-- Scrim under dialogs. -->
    <color name="scrim">#FF000000</color>
    <!-- Custom roles (M3 "custom colours"), harmonised to the seed: success = blocking works, warning = paused. -->
    <color name="success">#FF286A48</color>
    <color name="on_success">#FFFFFFFF</color>
    <color name="warning">#FF7D5700</color>
    <color name="on_warning">#FFFFFFFF</color>
    <color name="warning_container">#FFFFDEAA</color>
    <color name="on_warning_container">#FF271900</color>
</resources>
