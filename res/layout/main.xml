<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="32dp" android:paddingBottom="24dp">

        <!-- Header: what this app is, in one line. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="56dp" android:layout_height="56dp"
                android:src="@mipmap/ic_launcher" android:importantForAccessibility="no" />
            <TextView style="@style/Text.Display" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:text="Reel Block" android:accessibilityHeading="true" />
        </LinearLayout>
        <TextView style="@style/Text.Muted" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="16sp"
            android:text="@string/tagline" />

        <!-- Status: on or off, the count, and the one action that matters. -->
        <LinearLayout style="@style/Card" android:layout_marginTop="24dp">
            <TextView android:id="@+id/pill" style="@style/Text.Label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:background="@drawable/pill"
                android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp"
                android:paddingBottom="4dp" />
            <!-- In-app on/off. Shown only when the service is on; keeps the service bound, so no re-setup. -->
            <Switch android:id="@+id/block_switch" style="@style/Text" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp"
                android:text="@string/block_switch" android:textSize="16sp" android:visibility="gone" />
            <TextView android:id="@+id/headline" style="@style/Text.Title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/body" style="@style/Text.Muted" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/count" style="@style/Text.Number" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="16dp" />
            <TextView style="@style/Text.Muted" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/closed_label" />
            <Button android:id="@+id/turn_on" style="@style/Button.Primary" />
        </LinearLayout>

        <!-- Shown only on phones with the Xiaomi Autostart screen. -->
        <LinearLayout android:id="@+id/autostart_card" style="@style/Card" android:visibility="gone">
            <TextView style="@style/Text.Title" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/autostart_title"
                android:accessibilityHeading="true" />
            <TextView style="@style/Text.Muted" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/autostart_body" />
            <Button android:id="@+id/autostart" style="@style/Button.Secondary" android:text="@string/autostart" />
        </LinearLayout>

        <!-- Shown only while the blocker is off. -->
        <LinearLayout android:id="@+id/setup" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout style="@style/Card">
                <TextView style="@style/Text.Title" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/how_title"
                    android:accessibilityHeading="true" />
                <LinearLayout style="@style/Row">
                    <TextView style="@style/Bullet.Step" android:text="1" />
                    <TextView style="@style/RowText" android:text="@string/step1" />
                </LinearLayout>
                <LinearLayout style="@style/Row">
                    <TextView style="@style/Bullet.Step" android:text="2" />
                    <TextView style="@style/RowText" android:text="@string/step2" />
                </LinearLayout>
                <LinearLayout style="@style/Row">
                    <TextView style="@style/Bullet.Step" android:text="3" />
                    <TextView style="@style/RowText" android:text="@string/step3" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout style="@style/Card">
                <TextView style="@style/Text.Title" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/help_title"
                    android:accessibilityHeading="true" />
                <TextView style="@style/Text.Muted" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="@string/help_body" />
                <Button android:id="@+id/app_info" style="@style/Button.Secondary" android:text="@string/app_info" />
            </LinearLayout>
        </LinearLayout>

        <!-- Privacy: the promises the code keeps. -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/Text.Title" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/privacy_title"
                android:accessibilityHeading="true" />
            <LinearLayout style="@style/Row">
                <TextView style="@style/Bullet.Check" android:text="✓" />
                <TextView style="@style/RowText" android:text="@string/privacy1" />
            </LinearLayout>
            <LinearLayout style="@style/Row">
                <TextView style="@style/Bullet.Check" android:text="✓" />
                <TextView style="@style/RowText" android:text="@string/privacy2" />
            </LinearLayout>
            <LinearLayout style="@style/Row">
                <TextView style="@style/Bullet.Check" android:text="✓" />
                <TextView style="@style/RowText" android:text="@string/privacy3" />
            </LinearLayout>
        </LinearLayout>

        <Button android:id="@+id/share" style="@style/Button.Text" android:text="@string/share" />
    </LinearLayout>
</ScrollView>
