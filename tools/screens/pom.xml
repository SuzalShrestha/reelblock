<!-- Screenshot and label audit harness for docs/screens. A dev tool, not part of the app or its build:
     the app is built by ../../build.sh with no Gradle and no libraries. This uses Maven only to fetch
     Robolectric from Maven Central. Run it with tools/screens/run.sh. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.local.reelblock</groupId><artifactId>screens</artifactId><version>1</version>
  <properties>
    <maven.compiler.source>17</maven.compiler.source><maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <!-- androidx.test is only on Google's Maven; src/test/java/androidx has the few classes Robolectric needs. -->
    <dependency><groupId>org.robolectric</groupId><artifactId>robolectric</artifactId><version>4.14.1</version><scope>test</scope>
      <exclusions>
        <exclusion><groupId>androidx.test</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>androidx.test.espresso</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>androidx.annotation</groupId><artifactId>*</artifactId></exclusion>
      </exclusions></dependency>
    <dependency><groupId>org.robolectric</groupId><artifactId>android-all</artifactId><version>14-robolectric-10818077</version><scope>provided</scope></dependency>
    <dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
    <dependency><groupId>dev.local.reelblock</groupId><artifactId>app</artifactId><version>1</version><scope>system</scope><systemPath>${appjar}</systemPath></dependency>
  </dependencies>
  <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version>
    <dependencies><dependency><groupId>org.apache.maven.surefire</groupId><artifactId>surefire-junit4</artifactId><version>3.2.5</version></dependency></dependencies>
    <configuration>
      <includes><include>**/${shotsclass}.java</include></includes>
      <argLine>-Xmx3g</argLine>
      <systemPropertyVariables>
        <shots.out>${shotsout}</shots.out><shots.variants>${shotsvariants}</shots.variants>
        <!-- Instrument android-all at run time, so the large pre-instrumented jar is not needed. -->
        <robolectric.usePreinstrumentedJars>false</robolectric.usePreinstrumentedJars>
      </systemPropertyVariables>
    </configuration></plugin></plugins></build>
</project>
