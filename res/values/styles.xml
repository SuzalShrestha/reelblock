<?xml version="1.0" encoding="utf-8"?>
<!-- Themes and components. Every value is a token from colors*.xml, dimens.xml, type.xml or motion.xml.
     docs/design-system.md shows each component. -->
<resources>
    <style name="Theme.ReelBlock" parent="Base.Theme">
        <item name="android:windowBackground">@color/bg_window</item>
        <item name="android:colorBackground">@color/bg_window</item>
        <item name="android:statusBarColor">@color/bg_window</item>
        <item name="android:navigationBarColor">@color/nav_bar</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorControlHighlight">@color/state_on_surface</item>
        <item name="android:colorEdgeEffect">@color/primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorLink">@color/text_link</item>
        <item name="android:textColorHighlight">@color/primary_container</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimation</item>
    </style>
    <style name="WindowAnimation" parent="android:Animation.Activity" />

    <!-- Dialog: M3 basic dialog. 28dp corners, surface container high, scrim at 32%. -->
    <style name="Theme.ReelBlock.Dialog" parent="Base.Dialog">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:windowMinWidthMajor">@fraction/dialog_width_major</item>
        <item name="android:windowMinWidthMinor">@fraction/dialog_width_minor</item>
        <item name="android:backgroundDimAmount">@dimen/scrim_alpha</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorControlHighlight">@color/state_on_surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <!-- Layout helpers. -->
    <style name="Screen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/margin_screen</item>
        <item name="android:paddingEnd">@dimen/margin_screen</item>
        <item name="android:paddingBottom">@dimen/space_8</item>
    </style>

    <!-- Card: flat container on the window colour. -->
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_3</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/space_5</item>
        <item name="android:background">@drawable/bg_card</item>
    </style>

    <!-- Status hero: the one big card that says what is happening. -->
    <style name="Hero" parent="Card">
        <item name="android:layout_marginTop">@dimen/space_4</item>
        <item name="android:padding">@dimen/space_6</item>
        <item name="android:background">@drawable/bg_hero</item>
    </style>
    <style name="HeroBadge">
        <item name="android:layout_width">@dimen/badge_hero</item>
        <item name="android:layout_height">@dimen/badge_hero</item>
        <item name="android:padding">@dimen/space_4</item>
        <item name="android:layout_marginTop">@dimen/space_0</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Buttons. Height 48dp minimum (touch target); the main action is 56dp (M3 Expressive "medium"). -->
    <style name="Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:layout_marginTop">@dimen/space_4</item>
        <item name="android:paddingStart">@dimen/button_padding_h</item>
        <item name="android:paddingEnd">@dimen/button_padding_h</item>
        <item name="android:paddingTop">@dimen/space_3</item>
        <item name="android:paddingBottom">@dimen/space_3</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/Text.LabelLarge</item>
        <item name="android:textSize">@dimen/type_title_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@animator/press</item>
        <item name="android:elevation">@dimen/elevation_0</item>
    </style>
    <style name="Button.Filled">
        <item name="android:minHeight">@dimen/button_height_large</item>
        <item name="android:background">@drawable/btn_filled</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>
    <style name="Button.Tonal">
        <item name="android:background">@drawable/btn_tonal</item>
        <item name="android:textColor">@color/on_secondary_container</item>
    </style>
    <style name="Button.Text">
        <item name="android:background">@drawable/btn_text</item>
        <item name="android:textColor">@color/primary</item>
    </style>
    <style name="IconButton">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:padding">@dimen/space_3</item>
        <item name="android:background">@drawable/btn_icon</item>
        <item name="android:tint">@color/text_primary</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <!-- List row: icon, title, supporting text, trailing icon. 56dp one line, 72dp two lines. -->
    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/gap_group</item>
        <item name="android:minHeight">@dimen/list_two_line</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:paddingEnd">@dimen/space_4</item>
        <item name="android:paddingTop">@dimen/space_3</item>
        <item name="android:paddingBottom">@dimen/space_3</item>
        <item name="android:background">@drawable/bg_row_middle</item>
    </style>
    <style name="Row.Top"><item name="android:background">@drawable/bg_row_top</item><item name="android:layout_marginTop">@dimen/space_2</item></style>
    <style name="Row.Bottom"><item name="android:background">@drawable/bg_row_bottom</item></style>
    <style name="Row.Single"><item name="android:background">@drawable/bg_row_single</item><item name="android:layout_marginTop">@dimen/space_2</item></style>
    <style name="RowIcon">
        <item name="android:layout_width">@dimen/badge_list</item>
        <item name="android:layout_height">@dimen/badge_list</item>
        <item name="android:padding">@dimen/space_2</item>
        <item name="android:layout_marginEnd">@dimen/space_4</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:backgroundTint">@color/secondary_container</item>
        <item name="android:tint">@color/on_secondary_container</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="RowTexts">
        <item name="android:layout_width">@dimen/space_0</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="RowTitle" parent="Text.BodyLarge">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="RowBody" parent="Text.BodyMedium.Secondary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="RowTrailing">
        <item name="android:layout_width">@dimen/icon_md</item>
        <item name="android:layout_height">@dimen/icon_md</item>
        <item name="android:layout_marginStart">@dimen/space_3</item>
        <item name="android:tint">@color/icon_default</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <!-- Bullet row inside a card (no touch). -->
    <style name="Bullet">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_3</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="BulletIcon">
        <item name="android:layout_width">@dimen/icon_md</item>
        <item name="android:layout_height">@dimen/icon_md</item>
        <item name="android:layout_marginEnd">@dimen/space_3</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="BulletText" parent="Text.BodyLarge">
        <item name="android:layout_width">@dimen/space_0</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

    <!-- Step number in a tonal circle. -->
    <style name="Step" parent="Text.TitleSmall">
        <item name="android:layout_width">@dimen/step_badge</item>
        <item name="android:layout_height">@dimen/step_badge</item>
        <item name="android:layout_marginEnd">@dimen/space_3</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:backgroundTint">@color/primary_container</item>
        <item name="android:textColor">@color/on_primary_container</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Dialog parts. -->
    <style name="Dialog.Title" parent="Text.HeadlineSmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/space_6</item>
        <item name="android:paddingEnd">@dimen/space_6</item>
        <item name="android:paddingTop">@dimen/space_6</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="Dialog.Body" parent="Text.BodyMedium.Secondary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/space_6</item>
        <item name="android:paddingEnd">@dimen/space_6</item>
        <item name="android:paddingTop">@dimen/space_4</item>
    </style>
    <style name="Dialog.Option" parent="Text.BodyLarge">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/list_one_line</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">@dimen/space_6</item>
        <item name="android:paddingEnd">@dimen/space_6</item>
        <item name="android:drawablePadding">@dimen/space_4</item>
        <item name="android:drawableTint">@color/icon_default</item>
        <item name="android:background">@drawable/bg_option</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="Dialog.Button" parent="Button.Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_gravity">end</item>
        <item name="android:layout_marginTop">@dimen/space_2</item>
        <item name="android:layout_marginEnd">@dimen/space_3</item>
        <item name="android:layout_marginBottom">@dimen/space_3</item>
        <item name="android:textSize">@dimen/type_label_large</item>
    </style>

    <!-- Switch row: M3 switch at the end, label at the start; the whole row is the touch target. -->
    <style name="SwitchRow" parent="Text.TitleMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/list_one_line</item>
        <item name="android:layout_marginTop">@dimen/space_4</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:paddingEnd">@dimen/space_3</item>
        <item name="android:background">@drawable/bg_switch_row</item>
        <item name="android:track">@drawable/switch_track</item>
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="android:switchMinWidth">@dimen/switch_track_width</item>
        <item name="android:thumbTextPadding">@dimen/space_0</item>
        <item name="android:switchPadding">@dimen/space_4</item>
        <item name="android:showText">false</item>
        <item name="android:splitTrack">false</item>
    </style>

    <!-- Section header above a group. -->
    <style name="SectionHeader" parent="Text.Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_6</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:paddingEnd">@dimen/space_4</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <!-- Empty state: icon, title, one line of help. -->
    <style name="EmptyState.Title" parent="Text.TitleMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_3</item>
    </style>
</resources>
