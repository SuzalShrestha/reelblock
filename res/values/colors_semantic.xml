<?xml version="1.0" encoding="utf-8"?>
<!-- Semantic colours: what a colour is FOR. Layouts and code use these, not the role names.
     values-night/colors_semantic.xml maps the same names for dark mode. -->
<resources>
    <color name="bg_window">@color/surface_container</color>
    <color name="bg_card">@color/surface_container_lowest</color>
    <color name="bg_dialog">@color/surface_container_high</color>
    <color name="text_primary">@color/on_surface</color>
    <color name="text_secondary">@color/on_surface_variant</color>
    <color name="text_link">@color/primary</color>
    <color name="icon_default">@color/on_surface_variant</color>
    <color name="divider">@color/outline_variant</color>
    <!-- Status hero, one set per state. -->
    <color name="hero_on_bg">@color/primary_container</color>
    <color name="hero_on_fg">@color/on_primary_container</color>
    <color name="hero_on_badge">@color/primary</color>
    <color name="hero_on_badge_icon">@color/on_primary</color>
    <color name="hero_paused_bg">@color/warning_container</color>
    <color name="hero_paused_fg">@color/on_warning_container</color>
    <color name="hero_paused_badge">@color/warning</color>
    <color name="hero_paused_badge_icon">@color/on_warning</color>
    <color name="hero_off_bg">@color/bg_card</color>
    <color name="hero_off_fg">@color/on_surface</color>
    <color name="hero_off_badge">@color/surface_container_highest</color>
    <color name="hero_off_badge_icon">@color/on_surface_variant</color>
    <color name="hero_problem_bg">@color/error_container</color>
    <color name="hero_problem_fg">@color/on_error_container</color>
    <color name="hero_problem_badge">@color/error</color>
    <color name="hero_problem_badge_icon">@color/on_error</color>
    <!-- Week chart. Bars need 3:1 against the card. -->
    <color name="chart_bar">@color/outline</color>
    <color name="chart_bar_today">@color/primary</color>
    <color name="chart_empty">@color/outline_variant</color>
    <!-- Brand mark (launcher icon and in-app logo). Fixed, never dynamic: the brand stays recognisable. -->
    <color name="brand_bg_top">#FF00696B</color>
    <color name="brand_bg_bottom">#FF0B5153</color>
    <color name="brand_fg">#FFBFEFEC</color>
    <color name="brand_fg_back">#73BFEFEC</color>
    <color name="brand_glyph">#FF0B5153</color>
    <!-- Android 8.0 has no light navigation bar (API 27), so its white buttons need a dark bar. -->
    <color name="nav_bar">@color/scrim</color>
    <bool name="light_bars">true</bool>
</resources>
