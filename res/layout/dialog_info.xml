<?xml version="1.0" encoding="utf-8"?>
<!-- Simple dialog: title, text, one button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/dialog_title" style="@style/Dialog.Title" />
    <TextView android:id="@+id/dialog_body" style="@style/Dialog.Body" />
    <Button android:id="@+id/dialog_ok" style="@style/Dialog.Button" android:layout_marginTop="@dimen/space_4" android:text="@string/ok" />
</LinearLayout>
