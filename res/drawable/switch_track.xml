<?xml version="1.0" encoding="utf-8"?>
<!-- M3 switch track: 52x32, primary when on, outlined when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape><solid android:color="@color/primary" /><corners android:radius="@dimen/radius_full" />
            <size android:width="@dimen/switch_track_width" android:height="@dimen/switch_track_height" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/surface_container_highest" />
            <stroke android:width="@dimen/stroke_outline" android:color="@color/outline" />
            <corners android:radius="@dimen/radius_full" />
            <size android:width="@dimen/switch_track_width" android:height="@dimen/switch_track_height" /></shape>
    </item>
</selector>
